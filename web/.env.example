# The deployed Embargo contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts), with the four demo pages found as
# scripted; no wallet and no network. For local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository (https://github.com/<owner>/<name>): the footer's Source link, and the repository the
# demo outlets' pinned prefixes are built from. On Vercel the repository the site was built from is used when this
# is empty (its NEXT_PUBLIC_VERCEL_GIT_* system variables).
NEXT_PUBLIC_REPO_URL=

# The commit (40 hex characters) whose outlets/ the demo outlets publish under, as raw.githubusercontent.com serves
# them. Empty: lib/config.ts OUTLETS_COMMIT is used; with both empty no demo release can be opened.
NEXT_PUBLIC_OUTLETS_COMMIT=

# Server only. One throwaway Studio secret, 64 hex characters (with or without 0x, with or without quotes). The demo
# desk derives three accounts from it, keccak256 of the key plus a label: the issuer, harbour-post and bay-gazette.
# POST /api/demo/open and /api/demo/join sign with them: issue() of the one demo release, and join() by the two demo
# outlets with their fixed prefixes. Never a key that holds anything real. Unset: the site works, and
# GET /api/demo/status says exactly why the demo desk is away.
DEMO_KEY=
